{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && NODE_TLS_REJECT_UNAUTHORIZED=0 firebase emulators:start --only functions,storage",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.3.1",
    "ffmpeg-static": "^5.2.0",
    "firebase-admin": "^13.0.1",
    "firebase-functions": "^7.0.5",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.2.0",
    "google-auth-library": "^10.5.0",
    "googleapis": "^171.4.0"
  },
  "devDependencies": {
    "@types/ffmpeg-static": "^3.0.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  },
  "private": true
}
